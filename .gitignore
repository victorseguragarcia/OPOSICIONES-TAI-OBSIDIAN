# Git Ignore for LLM Wiki

# Raw immutable sources & binary documents (PDFs, large binaries)
raw/
*.pdf

# One-off generator and extraction scratch scripts
scripts/generate_*.py
scripts/adapt_*.py
scripts/deepen_*.py
scripts/expand_*.py
scripts/extract_*.py
scripts/ingest_*.py
scripts/create_*.py
scripts/enhance_*.py
scripts/verify_*.py

# Obsidian internal workspace, cache and untitled temp files
.obsidian/workspace*
.obsidian/cache/
.obsidian/local/
Sin título*.canvas
*.canvas.tmp

# Editor configurations and caches
.vscode/
.idea/
.agents/
.claude/

# Python caches and temporary files
__pycache__/
*.pyc
*.tmp
*.temp

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
